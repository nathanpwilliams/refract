SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=jwt-secret-here
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
ANTHROPIC_API_KEY=sk-ant-...
ADAPTATION_MODEL=claude-sonnet-4-6

# Pipeline v2 cross-model verification. VERIFY runs twice; a 'blocker'
# from either model halts the version. Optional "<provider>:<model>"
# prefix (default anthropic) so a second vendor can be added by env alone.
# VERIFY_MODEL_A empty => ADAPTATION_MODEL.
VERIFY_MODEL_A=
VERIFY_MODEL_B=claude-haiku-4-5
